{
  "entities": {
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Configuración general de la empresa (logo, reglas de horas normales y catálogo de sectores).",
      "type": "object",
      "properties": {
        "companyLogo": {
          "type": "string",
          "maxLength": 150000,
          "description": "Data URL optimizado del logo de la empresa o cadena vacía."
        },
        "wd": {
          "type": "number",
          "description": "Horas normales de lunes a viernes (1 a 24)."
        },
        "sat": {
          "type": "number",
          "description": "Horas normales de sábado (0 a 24)."
        },
        "sectors": {
          "type": "array",
          "description": "Lista acotada de hasta 50 sectores/áreas de la empresa."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo de última actualización del servidor."
        }
      },
      "required": ["companyLogo", "wd", "sat", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registro de administradores autorizados por UID de Firebase Auth.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Ficha completa de funcionario con tarifa horaria, % extra, fecha de ingreso y recuperación de PIN.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ci": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "ciNormalized": {
          "type": "string",
          "maxLength": 30
        },
        "sector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "pin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "hireDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "hourlyRate": {
          "type": "number"
        },
        "overtimePct": {
          "type": "number"
        },
        "hasIps": {
          "type": "boolean"
        },
        "ipsAmount": {
          "type": "number"
        },
        "lastClosedDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "carryOverBalance": {
          "type": "number"
        },
        "pinResetEnabled": {
          "type": "boolean"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "ci", "sector", "pin", "ownerUid", "email", "active", "createdAt", "updatedAt"]
    },
    "AttendanceMark": {
      "title": "AttendanceMark",
      "description": "Marcaciones diarias de un funcionario (Ent. 1, Sal. 2, Ent. 3, Sal. 4) con ubicación GPS.",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "e1": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^(|[0-9]{2}:[0-9]{2}:[0-9]{2})$"
        },
        "s2": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^(|[0-9]{2}:[0-9]{2}:[0-9]{2})$"
        },
        "e3": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^(|[0-9]{2}:[0-9]{2}:[0-9]{2})$"
        },
        "s4": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^(|[0-9]{2}:[0-9]{2}:[0-9]{2})$"
        },
        "punchTs": {
          "type": "object",
          "description": "Timestamps epoch (ms) opcionales para e1, s2, e3, s4 que permiten cálculo continuo a través de medianoche."
        },
        "extraPunches": {
          "type": "array",
          "description": "Lista acotada de hasta 20 turnos extra {in, out, inTs, outTs} por jornada."
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "hasGps": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "ownerUid", "date", "e1", "s2", "e3", "s4", "lat", "lng", "hasGps", "createdAt", "updatedAt"]
    },
    "GpsLive": {
      "title": "GpsLive",
      "description": "Última posición GPS en tiempo real del funcionario en obra.",
      "type": "object",
      "properties": {
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "empName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sector": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "accuracy": { "type": "number" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "time": { "type": "string", "minLength": 8, "maxLength": 8, "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "ownerUid", "empName", "sector", "lat", "lng", "accuracy", "date", "time", "updatedAt"]
    },
    "GpsHistory": {
      "title": "GpsHistory",
      "description": "Recorrido GPS diario de un funcionario (hasta 300 puntos por jornada).",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "points": { "type": "array", "description": "Lista acotada de hasta 300 puntos {lat, lng, t}." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "ownerUid", "date", "points", "updatedAt"]
    },
    "PayrollLiquidation": {
      "title": "PayrollLiquidation",
      "description": "Registro cerrado de liquidación salarial o liquidación legal / indemnización (Paraguay).",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["salary", "legal"] },
        "employeeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "empName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "empCi": { "type": "string", "minLength": 1, "maxLength": 30 },
        "sector": { "type": "string", "minLength": 1, "maxLength": 80 },
        "periodStart": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "periodEnd": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "daysCount": { "type": "number" },
        "normalSec": { "type": "number" },
        "extraSec": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "overtimePct": { "type": "number" },
        "normalSubtotal": { "type": "number" },
        "extraSubtotal": { "type": "number" },
        "previousBalance": { "type": "number" },
        "ipsDeduction": { "type": "number" },
        "netTotal": { "type": "number" },
        "ipsApplied": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "type", "employeeId", "ownerUid", "empName", "empCi", "sector",
        "periodStart", "periodEnd", "daysCount", "normalSec", "extraSec",
        "hourlyRate", "overtimePct", "normalSubtotal", "extraSubtotal",
        "previousBalance", "ipsDeduction", "netTotal", "ipsApplied", "summary", "createdAt"
      ]
    },
    "ManualExpense": {
      "title": "ManualExpense",
      "description": "Gasto manual inmutable por sector o camión en guaraníes (no editable ni eliminable).",
      "type": "object",
      "properties": {
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sector": { "type": "string", "minLength": 1, "maxLength": 80 },
        "concept": { "type": "string", "minLength": 1, "maxLength": 200 },
        "invoice": { "type": "string", "maxLength": 60 },
        "amount": { "type": "number" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "sector", "concept", "invoice", "amount", "createdByUid", "createdAt"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Configuración global de la empresa (doc: company)."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administradores adicionales verificados."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Directorio de funcionarios, tarifas y recuperación de PIN."
    },
    "/marks/{markId}": {
      "schema": { "$ref": "#/entities/AttendanceMark" },
      "description": "Registros de asistencia diarios por funcionario (docId: {employeeId}_{YYYY-MM-DD})."
    },
    "/gpsLive/{employeeId}": {
      "schema": { "$ref": "#/entities/GpsLive" },
      "description": "Coordenada GPS más reciente por funcionario."
    },
    "/gpsHistory/{histId}": {
      "schema": { "$ref": "#/entities/GpsHistory" },
      "description": "Historial de recorrido GPS diario por funcionario."
    },
    "/payrolls/{payrollId}": {
      "schema": { "$ref": "#/entities/PayrollLiquidation" },
      "description": "Historial inmutable de liquidaciones salariales y legales cerradas."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ManualExpense" },
      "description": "Registro estrictamente inmutable de gastos manuales por sector o camión."
    }
  }
}
