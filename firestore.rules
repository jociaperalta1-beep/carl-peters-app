rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // === Global Hardened Primitives ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'jociaperalta1@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidDateOrEmpty(d) {
      return d is string && d.size() <= 10 && d.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$');
    }

    function isValidTimeOrEmpty(t) {
      return t is string && t.size() <= 8 && t.matches('^(|[0-9]{2}:[0-9]{2}:[0-9]{2})$');
    }

    function isValidTimeReq(t) {
      return t is string && t.size() == 8 && t.matches('^[0-9]{2}:[0-9]{2}:[0-9]{2}$');
    }

    function isValidLat(v) {
      return (v is float || v is int) && v >= -90 && v <= 90;
    }

    function isValidLng(v) {
      return (v is float || v is int) && v >= -180 && v <= 180;
    }

    function isNonNegNum(v, maxVal) {
      return (v is float || v is int) && v >= 0 && v <= maxVal;
    }

    // === Entity Validation Blueprints ===
    function isValidCompanySettings(data) {
      return data.keys().hasAll(['companyLogo', 'wd', 'sat', 'updatedAt']) &&
        data.keys().hasOnly(['companyLogo', 'wd', 'sat', 'sectors', 'updatedAt']) &&
        data.companyLogo is string && data.companyLogo.size() <= 150000 &&
        (data.wd is float || data.wd is int) && data.wd >= 1 && data.wd <= 24 &&
        (data.sat is float || data.sat is int) && data.sat >= 0 && data.sat <= 24 &&
        (!('sectors' in data) || (data.sectors is list && data.sectors.size() <= 50 && (data.sectors.size() == 0 || data.sectors[0] is string))) &&
        data.updatedAt == request.time;
    }

    function isValidAdminUser(data, isCreate) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['email', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp &&
        (!isCreate || data.createdAt == request.time);
    }

    function isValidEmployee(data, isCreate) {
      return data.keys().hasAll(['name', 'ci', 'sector', 'pin', 'ownerUid', 'email', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'name', 'ci', 'ciNormalized', 'sector', 'pin',
          'hireDate', 'hourlyRate', 'overtimePct', 'hasIps', 'ipsAmount',
          'lastClosedDate', 'carryOverBalance', 'pinResetEnabled',
          'ownerUid', 'email', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.ci is string && data.ci.size() >= 1 && data.ci.size() <= 30 &&
        (!('ciNormalized' in data) || (data.ciNormalized is string && data.ciNormalized.size() <= 30)) &&
        data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 80 &&
        data.pin is string && data.pin.size() == 4 && data.pin.matches('^[0-9]{4}$') &&
        (!('hireDate' in data) || isValidDateOrEmpty(data.hireDate)) &&
        (!('hourlyRate' in data) || isNonNegNum(data.hourlyRate, 10000000)) &&
        (!('overtimePct' in data) || isNonNegNum(data.overtimePct, 500)) &&
        (!('hasIps' in data) || data.hasIps is bool) &&
        (!('ipsAmount' in data) || isNonNegNum(data.ipsAmount, 100000000)) &&
        (!('lastClosedDate' in data) || isValidDateOrEmpty(data.lastClosedDate)) &&
        (!('carryOverBalance' in data) || isNonNegNum(data.carryOverBalance, 1000000000)) &&
        (!('pinResetEnabled' in data) || data.pinResetEnabled is bool) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.email is string && data.email.size() <= 120 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time &&
        (!isCreate || data.createdAt == request.time);
    }

    function isValidAttendanceMark(data, isCreate) {
      return data.keys().hasAll(['employeeId', 'ownerUid', 'date', 'e1', 's2', 'e3', 's4', 'lat', 'lng', 'hasGps', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['employeeId', 'ownerUid', 'date', 'e1', 's2', 'e3', 's4', 'punchTs', 'extraPunches', 'lat', 'lng', 'hasGps', 'createdAt', 'updatedAt']) &&
        isValidId(data.employeeId) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidDateStr(data.date) &&
        isValidTimeOrEmpty(data.e1) &&
        isValidTimeOrEmpty(data.s2) &&
        isValidTimeOrEmpty(data.e3) &&
        isValidTimeOrEmpty(data.s4) &&
        (!('punchTs' in data) || (data.punchTs is map && data.punchTs.size() <= 4)) &&
        (!('extraPunches' in data) || (data.extraPunches is list && data.extraPunches.size() <= 20 && (data.extraPunches.size() == 0 || data.extraPunches[0] is map))) &&
        isValidLat(data.lat) &&
        isValidLng(data.lng) &&
        data.hasGps is bool &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time &&
        (!isCreate || data.createdAt == request.time);
    }

    function isValidGpsLive(data) {
      return data.keys().hasAll(['employeeId', 'ownerUid', 'empName', 'sector', 'lat', 'lng', 'accuracy', 'date', 'time', 'updatedAt']) &&
        data.keys().hasOnly(['employeeId', 'ownerUid', 'empName', 'sector', 'lat', 'lng', 'accuracy', 'date', 'time', 'updatedAt']) &&
        isValidId(data.employeeId) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.empName is string && data.empName.size() >= 1 && data.empName.size() <= 100 &&
        data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 80 &&
        isValidLat(data.lat) &&
        isValidLng(data.lng) &&
        isNonNegNum(data.accuracy, 100000) &&
        isValidDateStr(data.date) &&
        isValidTimeReq(data.time) &&
        data.updatedAt == request.time;
    }

    function isValidGpsHistory(data) {
      return data.keys().hasAll(['employeeId', 'ownerUid', 'date', 'points', 'updatedAt']) &&
        data.keys().hasOnly(['employeeId', 'ownerUid', 'date', 'points', 'updatedAt']) &&
        isValidId(data.employeeId) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidDateStr(data.date) &&
        data.points is list && data.points.size() <= 300 &&
        (data.points.size() == 0 || data.points[0] is map) &&
        data.updatedAt == request.time;
    }

    function isValidPayroll(data) {
      return data.keys().hasAll([
          'type', 'employeeId', 'ownerUid', 'empName', 'empCi', 'sector',
          'periodStart', 'periodEnd', 'daysCount', 'normalSec', 'extraSec',
          'hourlyRate', 'overtimePct', 'normalSubtotal', 'extraSubtotal',
          'previousBalance', 'ipsDeduction', 'netTotal', 'ipsApplied', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'type', 'employeeId', 'ownerUid', 'empName', 'empCi', 'sector',
          'periodStart', 'periodEnd', 'daysCount', 'normalSec', 'extraSec',
          'hourlyRate', 'overtimePct', 'normalSubtotal', 'extraSubtotal',
          'previousBalance', 'ipsDeduction', 'netTotal', 'ipsApplied', 'summary', 'createdAt'
        ]) &&
        (data.type == 'salary' || data.type == 'legal') &&
        isValidId(data.employeeId) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.empName is string && data.empName.size() >= 1 && data.empName.size() <= 100 &&
        data.empCi is string && data.empCi.size() >= 1 && data.empCi.size() <= 30 &&
        data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 80 &&
        isValidDateStr(data.periodStart) &&
        isValidDateStr(data.periodEnd) &&
        isNonNegNum(data.daysCount, 3660) &&
        isNonNegNum(data.normalSec, 10000000) &&
        isNonNegNum(data.extraSec, 10000000) &&
        isNonNegNum(data.hourlyRate, 10000000) &&
        isNonNegNum(data.overtimePct, 500) &&
        isNonNegNum(data.normalSubtotal, 10000000000) &&
        isNonNegNum(data.extraSubtotal, 10000000000) &&
        isNonNegNum(data.previousBalance, 10000000000) &&
        isNonNegNum(data.ipsDeduction, 10000000000) &&
        isNonNegNum(data.netTotal, 10000000000) &&
        data.ipsApplied is bool &&
        data.summary is string && data.summary.size() <= 600 &&
        data.createdAt == request.time;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['date', 'sector', 'concept', 'invoice', 'amount', 'createdByUid', 'createdAt']) &&
        data.keys().hasOnly(['date', 'sector', 'concept', 'invoice', 'amount', 'createdByUid', 'createdAt']) &&
        isValidDateStr(data.date) &&
        data.sector is string && data.sector.size() >= 1 && data.sector.size() <= 80 &&
        data.concept is string && data.concept.size() >= 1 && data.concept.size() <= 200 &&
        data.invoice is string && data.invoice.size() <= 60 &&
        (data.amount is float || data.amount is int) && data.amount > 0 && data.amount <= 100000000000 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.createdAt == request.time;
    }

    // === Collection Rules ===

    // 1. Company Settings (single known doc: /settings/company)
    match /settings/{settingId} {
      allow get: if isVerifiedUser() && settingId == 'company';
      allow list: if false;
      allow create: if isVerifiedUser() && settingId == 'company' && isValidCompanySettings(incoming()) && isAdmin();
      allow update: if isVerifiedUser() && settingId == 'company' && isValidCompanySettings(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['companyLogo', 'wd', 'sat', 'sectors', 'updatedAt']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && settingId == 'company' && isAdmin();
    }

    // 2. Admins Registry
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser() && isValidId(adminUid) && isValidAdminUser(incoming(), true) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(adminUid) && isValidAdminUser(incoming(), false) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(adminUid) && isAdmin();
    }

    // 3. Employees (contains PII: CI, PIN, email)
    match /employees/{employeeId} {
      allow get: if isVerifiedUser() && isValidId(employeeId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        (existing().email != '' && existing().email == request.auth.token.email) ||
        ('pinResetEnabled' in existing() && existing().pinResetEnabled == true) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.email != '' && resource.data.email == request.auth.token.email) ||
        ('pinResetEnabled' in resource.data && resource.data.pinResetEnabled == true) ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(employeeId) && isValidEmployee(incoming(), true) && (
        (incoming().ownerUid == request.auth.uid && incoming().email == request.auth.token.email) ||
        isAdmin()
      );
      allow update: if isVerifiedUser() && isValidId(employeeId) && isValidEmployee(incoming(), false) &&
        incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (
          existing().ownerUid == request.auth.uid &&
          incoming().ownerUid == existing().ownerUid &&
          (!('pinResetEnabled' in incoming()) || incoming().pinResetEnabled == false) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pin', 'pinResetEnabled', 'name', 'sector', 'updatedAt'])
        ) ||
        (
          existing().email != '' &&
          existing().email == request.auth.token.email &&
          incoming().ownerUid == request.auth.uid &&
          (!('pinResetEnabled' in incoming()) || incoming().pinResetEnabled == false) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'pin', 'pinResetEnabled', 'updatedAt'])
        ) ||
        (
          'pinResetEnabled' in existing() &&
          existing().pinResetEnabled == true &&
          incoming().pinResetEnabled == false &&
          incoming().ownerUid == request.auth.uid &&
          incoming().email == request.auth.token.email &&
          incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'email', 'pin', 'pinResetEnabled', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(employeeId) && isAdmin();
    }

    // 4. Attendance Marks (docId: {employeeId}_{YYYY-MM-DD})
    match /marks/{markId} {
      allow get: if isVerifiedUser() && isValidId(markId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(markId) && isValidAttendanceMark(incoming(), true) &&
        (incoming().ownerUid == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/employees/$(incoming().employeeId));
      allow update: if isVerifiedUser() && isValidId(markId) && isValidAttendanceMark(incoming(), false) &&
        incoming().employeeId == existing().employeeId &&
        incoming().date == existing().date &&
        incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (
          existing().ownerUid == request.auth.uid &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['e1', 's2', 'e3', 's4', 'punchTs', 'extraPunches', 'lat', 'lng', 'hasGps', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(markId) && isAdmin();
    }

    // 5. GPS Live Locations (docId: {employeeId})
    match /gpsLive/{employeeId} {
      allow get: if isVerifiedUser() && isValidId(employeeId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(employeeId) && isValidGpsLive(incoming()) &&
        incoming().employeeId == employeeId &&
        (incoming().ownerUid == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/employees/$(employeeId));
      allow update: if isVerifiedUser() && isValidId(employeeId) && isValidGpsLive(incoming()) &&
        incoming().employeeId == existing().employeeId && (
        isAdmin() ||
        (
          existing().ownerUid == request.auth.uid &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['empName', 'sector', 'lat', 'lng', 'accuracy', 'date', 'time', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(employeeId) && isAdmin();
    }

    // 6. GPS Daily History (docId: {employeeId}_{YYYY-MM-DD})
    match /gpsHistory/{histId} {
      allow get: if isVerifiedUser() && isValidId(histId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(histId) && isValidGpsHistory(incoming()) &&
        (incoming().ownerUid == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/employees/$(incoming().employeeId));
      allow update: if isVerifiedUser() && isValidId(histId) && isValidGpsHistory(incoming()) &&
        incoming().employeeId == existing().employeeId &&
        incoming().date == existing().date && (
        isAdmin() ||
        (
          existing().ownerUid == request.auth.uid &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['points', 'updatedAt'])
        )
      );
      allow delete: if isVerifiedUser() && isValidId(histId) && isAdmin();
    }

    // 7. Payroll Liquidations (closed salary & legal indemnizations)
    match /payrolls/{payrollId} {
      allow get: if isVerifiedUser() && isValidId(payrollId) && (
        resource == null ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser() && isValidId(payrollId) && isValidPayroll(incoming()) &&
        isAdmin() &&
        exists(/databases/$(database)/documents/employees/$(incoming().employeeId));
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(payrollId) && isAdmin();
    }

    // 8. Manual Expenses (STRICTLY IMMUTABLE — no update or delete ever)
    match /expenses/{expenseId} {
      allow get: if isVerifiedUser() && isValidId(expenseId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser() && isValidId(expenseId) && isValidExpense(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        isAdmin();
      allow update: if false;
      allow delete: if false;
    }
  }
}
